# Python
__pycache__/
*.pyc
*.pyo

# Local HTML previews (generated output — committed version lives in docs/)
week_*_matchups.html

# ESPN play-by-play cache (large, re-fetchable)
Data/*/pbp/

# nflverse parquet cache (re-downloadable)
Data/*/nflverse/

